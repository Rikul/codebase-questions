# --- LLM (pick one; with neither key the app runs in offline static-analysis mode) ---
# LLM_PROVIDER=anthropic          # anthropic | openai | mock (auto-detected from keys)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# LLM_MODEL=claude-sonnet-5-5     # main model (architecture, insights, answers)
# LLM_FAST_MODEL=claude-haiku-5-5 # cheaper model for bulk per-file summaries
# OPENAI_BASE_URL=                # any OpenAI-compatible endpoint (e.g. Ollama, vLLM)
# LLM_CONCURRENCY=4

# --- Semantic search (optional; defaults to OpenAI embeddings when OPENAI_API_KEY is set) ---
# EMBEDDING_PROVIDER=openai       # openai | none
# EMBEDDING_MODEL=text-embedding-3-small

# --- Ingestion ---
# HISTORY_DEPTH=1000              # commits of git history to keep (0 = full history, -1 = none)
# HISTORY_INDEX_COMMITS=5000      # commits indexed for file timelines
# GITHUB_TOKEN=                   # read access for private GitHub repos
# MAX_LLM_FILES=150               # how many key files get an LLM summary
# MAX_REPO_MB=500
# MAX_REPO_FILES=20000

# --- Server / auth ---
# APP_PORT=3000                   # host port used by docker-compose
# SESSION_DAYS=30
# COOKIE_SECURE=true              # set when serving over HTTPS
# TRUST_PROXY=true                # set behind a reverse proxy so rate limiting sees client IPs
# AUTH_DISABLED=false             # never disable on a reachable network
